# ============================================
# YW-EIMS Docker 环境变量配置
# 部署前复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# PostgreSQL 数据库
POSTGRES_DB=eims
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# 后端数据库连接
DATABASE_URL=postgresql://change_me:change_me@postgres:5432/eims?schema=public

# JWT 密钥（生产环境请使用随机字符串）
JWT_SECRET=change_me_to_random_string
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change_me_to_random_string
JWT_REFRESH_EXPIRES_IN=7d

# 前端端口
APP_PORT=8003

# 跨域与前端地址
EIMS_FRONTEND_URL=http://localhost:8003
CORS_ORIGINS=http://localhost:8003

# 钉钉 OAuth（按需配置）
DINGTALK_OAUTH_CLIENT_ID=
DINGTALK_OAUTH_CLIENT_SECRET=
DINGTALK_OAUTH_REDIRECT_URI=
DINGTALK_OAUTH_SCOPES=openid
DINGTALK_OAUTH_DEBUG=false

# OAuth2/OIDC Provider（按需配置）
OAUTH2_PROVIDER_ENABLED=true
OAUTH2_AUTH_CODE_EXPIRES_IN=600
OAUTH2_ACCESS_TOKEN_EXPIRES_IN=3600
OAUTH2_REFRESH_TOKEN_EXPIRES_IN=2592000
OAUTH2_RSA_PRIVATE_KEY_PATH=./keys/oauth2.pem
OAUTH2_RSA_PUBLIC_KEY_PATH=./keys/oauth2.pub.pem
OAUTH2_ISSUER=http://localhost:8003
