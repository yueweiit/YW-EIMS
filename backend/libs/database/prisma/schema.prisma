generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "material", "mold", "oa"]
}

model User {
  id         Int      @id @default(autoincrement())
  userName   String   @unique @map("user_name")
  password   String
  realName   String?  @map("real_name")
  email      String?  @unique @db.VarChar(200)
  dingTalkSubject String? @unique @map("ding_talk_subject") @db.VarChar(200)
  roles      String[] @default([])
  buttons    String[] @default([])
  status     String   @default("1")
  createBy   String   @default("system") @map("create_by")
  createTime DateTime @default(now()) @map("create_time")
  updateBy   String?  @map("update_by")
  updateTime DateTime @updatedAt @map("update_time")
  authLoginTickets         AuthLoginTicket[]
  authRefreshSessions      AuthRefreshSession[]
  oauth2AuthorizationCodes Oauth2AuthorizationCode[]
  oauth2AccessTokens       Oauth2AccessToken[]
  oauth2RefreshTokens      Oauth2RefreshToken[]
  oauth2UserBindings       Oauth2UserBinding[]

  @@map("system_user")
  @@schema("public")
}

model AuthLoginTicket {
  id         Int      @id @default(autoincrement())
  ticketHash String   @unique @map("ticket_hash") @db.VarChar(128)
  userId     Int      @map("user_id")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("auth_login_tickets")
  @@schema("public")
}

model DingTalkOAuthState {
  id         Int       @id @default(autoincrement())
  nonce      String    @unique @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("dingtalk_oauth_states")
  @@schema("public")
}

/// EIMS 自身登录刷新会话。只保存刷新令牌哈希，支持撤销和轮换。
model AuthRefreshSession {
  id              Int       @id @default(autoincrement())
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  accessTokenHash String?   @unique @map("access_token_hash") @db.VarChar(64)
  familyId        String?   @map("family_id") @db.VarChar(64)
  userId          Int       @map("user_id")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("auth_refresh_sessions")
  @@schema("public")
}

/// OAuth2 第三方应用注册表
model Oauth2Client {
  id           Int      @id @default(autoincrement())
  clientId     String   @unique @map("client_id") @db.VarChar(128)
  clientSecret String   @map("client_secret") @db.VarChar(256)
  name         String   @map("name") @db.VarChar(200)
  description  String?  @map("description") @db.VarChar(500)
  redirectUris String[] @map("redirect_uris")
  scopes       String[] @default(["openid", "profile", "email"]) @map("scopes")
  pkceRequired Boolean  @default(true) @map("pkce_required")
  status       String   @default("1") @map("status")
  createBy     String?  @map("create_by") @db.VarChar(50)
  createTime   DateTime @default(now()) @map("create_time")
  updateBy     String?  @map("update_by") @db.VarChar(50)
  updateTime   DateTime @updatedAt @map("update_time")

  authorizationRequests Oauth2AuthorizationRequest[]
  authorizationCodes Oauth2AuthorizationCode[]
  accessTokens        Oauth2AccessToken[]
  refreshTokens      Oauth2RefreshToken[]
  userBindings       Oauth2UserBinding[]
  externalSystem     ExternalSystem?

  @@map("oauth2_clients")
  @@schema("public")
}

/// OAuth2 授权请求事务。授权页只携带随机事务 ID，真实参数保存在服务端。
model Oauth2AuthorizationRequest {
  id                  Int       @id @default(autoincrement())
  transactionId       String    @unique @map("transaction_id") @db.VarChar(128)
  clientId            String    @map("client_id") @db.VarChar(128)
  redirectUri         String    @map("redirect_uri") @db.VarChar(2000)
  scopes              String[]  @map("scopes")
  state               String    @db.VarChar(512)
  browserNonceHash    String    @map("browser_nonce_hash") @db.VarChar(64)
  nonce               String?   @db.VarChar(255)
  codeChallenge       String?   @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String?   @map("code_challenge_method") @db.VarChar(10)
  expiresAt            DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  client Oauth2Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
  @@map("oauth2_authorization_requests")
  @@schema("public")
}

/// OAuth2 授权码表
model Oauth2AuthorizationCode {
  id                  Int       @id @default(autoincrement())
  code                String    @unique @map("code") @db.VarChar(256)
  clientId            String    @map("client_id") @db.VarChar(128)
  userId              Int       @map("user_id")
  redirectUri         String    @map("redirect_uri") @db.VarChar(2000)
  scopes              String[]  @map("scopes")
  nonce               String?   @db.VarChar(255)
  codeChallenge       String?   @map("code_challenge") @db.VarChar(256)
  codeChallengeMethod String?   @map("code_challenge_method") @db.VarChar(10)
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  client Oauth2Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("oauth2_authorization_codes")
  @@schema("public")
}

/// OAuth2 Access Token 记录。令牌本体只在客户端保存，EIMS 只保存哈希以支持撤销。
model Oauth2AccessToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  clientId  String    @map("client_id") @db.VarChar(128)
  userId    Int       @map("user_id")
  scopes    String[]  @map("scopes")
  familyId  String?   @map("family_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  client Oauth2Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("oauth2_access_tokens")
  @@schema("public")
}

/// OAuth2 刷新令牌表
model Oauth2RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.VarChar(256)
  clientId  String    @map("client_id") @db.VarChar(128)
  userId    Int       @map("user_id")
  scopes    String[]  @map("scopes")
  familyId  String?   @map("family_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  client Oauth2Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("oauth2_refresh_tokens")
  @@schema("public")
}

/// 多实例共享的认证接口限流桶。
model SecurityRateLimitBucket {
  bucketKey    String   @id @map("bucket_key") @db.VarChar(512)
  requestCount Int      @map("request_count")
  resetAt      DateTime @map("reset_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("security_rate_limit_buckets")
  @@schema("public")
}

/// OAuth2 用户绑定表（SSO 用户与业务系统用户的映射关系，不维护业务系统角色）
model Oauth2UserBinding {
  id          Int      @id @default(autoincrement())
  ssoUserId   Int      @map("sso_user_id")
  clientId    String   @map("client_id") @db.VarChar(128)
  appUserId   String   @map("app_user_id") @db.VarChar(255)
  appUsername String?  @map("app_username") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ssoUser User         @relation(fields: [ssoUserId], references: [id], onDelete: Cascade)
  client  Oauth2Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([ssoUserId, clientId])
  @@unique([clientId, appUserId])
  @@index([ssoUserId])
  @@index([clientId])
  @@map("oauth2_user_bindings")
  @@schema("public")
}

/// 外部系统门户目录。入口地址、可选 SSO 启动地址和展示信息由 EIMS 管理，访问权限由 accessMode/allowedRoles 决定。
/// accessMode=all 表示所有已登录用户可见；accessMode=roles 时必须命中 allowedRoles；R_SUPER 可以访问所有启用系统。
model ExternalSystem {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(100)
  description   String?  @db.VarChar(500)
  icon          String   @default("mdi:application-outline") @db.VarChar(100)
  color         String   @default("#2080f0") @db.VarChar(20)
  entryUrl      String   @map("entry_url") @db.VarChar(2000)
  ssoStartUrl   String?  @map("sso_start_url") @db.VarChar(2000)
  authMode      String   @default("link") @map("auth_mode") @db.VarChar(20)
  accessMode    String   @default("roles") @map("access_mode") @db.VarChar(20)
  allowedRoles  String[] @default([]) @map("allowed_roles")
  category      String   @default("业务系统") @db.VarChar(50)
  helpUrl       String?  @map("help_url") @db.VarChar(2000)
  feedbackUrl   String?  @map("feedback_url") @db.VarChar(2000)
  contact       String?  @db.VarChar(200)
  oauthClientId String?  @unique @map("oauth_client_id") @db.VarChar(128)
  sort          Int      @default(0)
  status        String   @default("1") @db.VarChar(1)
  createBy      String?  @map("create_by") @db.VarChar(50)
  createTime    DateTime @default(now()) @map("create_time")
  updateBy      String?  @map("update_by") @db.VarChar(50)
  updateTime    DateTime @updatedAt @map("update_time")

  oauthClient Oauth2Client? @relation(fields: [oauthClientId], references: [clientId], onDelete: SetNull, onUpdate: Cascade)

  permissions SystemPermission[]

  @@index([status])
  @@index([sort])
  @@map("external_systems")
  @@schema("public")
}

/// EIMS 角色主数据。User.roles 仍保存角色编码，便于兼容现有用户数据。
model SystemRole {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  builtIn     Boolean  @default(false) @map("built_in")
  sort        Int      @default(0)
  status      String   @default("1") @db.VarChar(1)
  createBy    String?  @map("create_by") @db.VarChar(50)
  createTime  DateTime @default(now()) @map("create_time")
  updateBy    String?  @map("update_by") @db.VarChar(50)
  updateTime  DateTime @updatedAt @map("update_time")

  permissions SystemRolePermission[]

  @@index([status])
  @@index([sort])
  @@map("system_roles")
  @@schema("public")
}

/// EIMS 菜单、按钮和 API 功能权限目录。
model SystemPermission {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  type        String   @default("menu") @db.VarChar(20)
  systemCode  String?  @map("system_code") @db.VarChar(50)
  parentCode  String?  @map("parent_code") @db.VarChar(100)
  routePath   String?  @map("route_path") @db.VarChar(500)
  description String?  @db.VarChar(500)
  sort        Int      @default(0)
  status      String   @default("1") @db.VarChar(1)
  createBy    String?  @map("create_by") @db.VarChar(50)
  createTime  DateTime @default(now()) @map("create_time")
  updateBy    String?  @map("update_by") @db.VarChar(50)
  updateTime  DateTime @updatedAt @map("update_time")

  externalSystem ExternalSystem?       @relation(fields: [systemCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  roles          SystemRolePermission[]

  @@index([systemCode])
  @@index([type])
  @@index([status])
  @@index([sort])
  @@map("system_permissions")
  @@schema("public")
}

/// 角色与功能权限的多对多关系。
model SystemRolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       SystemRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SystemPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("system_role_permissions")
  @@schema("public")
}

/// 登录、OAuth、门户和权限变更审计日志。detail 禁止保存密码、Token、Secret、授权码和 state。
model SecurityAuditLog {
  id         Int      @id @default(autoincrement())
  event      String   @db.VarChar(80)
  result     String   @default("success") @db.VarChar(20)
  userId     Int?     @map("user_id")
  userName   String?  @map("user_name") @db.VarChar(100)
  clientId   String?  @map("client_id") @db.VarChar(128)
  systemCode String?  @map("system_code") @db.VarChar(50)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([clientId, createdAt])
  @@map("security_audit_logs")
  @@schema("public")
}

/// 物料申请主数据表（存储所有物料申请记录）
model Material {
  id              Int       @id @default(autoincrement())
  applicant       String    @db.VarChar(50)
  applicationDate DateTime? @default(now()) @map("application_date") @db.Date
  materialName    String    @map("material_name") @db.VarChar(500)
  specifications  String?   @db.VarChar(1000)
  unit            String?   @db.VarChar(20)
  code            String?   @unique @db.VarChar(50)
  codePrefix      String?   @map("code_prefix") @db.VarChar(10)
  explainContent  String?   @map("explain_content") @db.VarChar(100)
  unitCode        String?   @map("unit_code") @db.VarChar(3)
  unitRef         Unit?     @relation(fields: [unitCode], references: [unitCode], onDelete: SetNull, onUpdate: Cascade)

  @@index([applicant])
  @@index([applicationDate])
  @@index([codePrefix])
  @@index([unitCode])
  @@index([materialName])
  @@map("materials")
  @@schema("material")
}

/// 存储单位编码与名称的映射表，编码统一为两位数格式（个位数补零）
model Unit {
  unitCode  String     @id @map("unit_code") @db.VarChar(3)
  unit      String     @unique @db.VarChar(50)
  materials Material[]

  @@map("units")
  @@schema("material")
}

/// 编码前缀字典表（存储字母前缀及对应含义）
model MaterialCodeRule {
  codePrefix     String  @id @map("code_prefix") @db.VarChar(10)
  explainContent String  @map("explain_content") @db.VarChar(100)
  prefixLength   Int?    @map("prefix_length")

  @@map("material_code_rules")
  @@schema("material")
}

// ============ MOLD SCHEMA ============

/// 手机编码序列表（保证 phoneCode 并发安全生成）
model PhoneCodeSequence {
  id           Int @id @default(autoincrement())
  currentValue Int @default(0) @map("current_value")

  @@map("phone_code_sequence")
  @@schema("mold")
}

/// 手机型号表
model PhoneModel {
  id             Int     @id @default(autoincrement())
  phoneCode      String  @unique @map("phone_code") @db.VarChar(20)
  phoneName      String  @unique @map("phone_name") @db.VarChar(200)
  phoneShortName String? @map("phone_short_name") @db.VarChar(200)

  @@index([phoneName])
  @@map("phone_models")
  @@schema("mold")
}

/// 颜色表
model Color {
  id        Int    @id @default(autoincrement())
  colorCode String @unique @map("color_code") @db.VarChar(10)
  colorName String @map("color_name") @db.VarChar(100)

  @@map("colors")
  @@schema("mold")
}

/// 材质表
model MoldMaterial {
  id       Int    @id @default(autoincrement())
  typeCode String @unique @map("type_code") @db.VarChar(10)
  typeName String @map("type_name") @db.VarChar(50)

  @@map("type")
  @@schema("mold")
}

/// 模具编码表（一个 moldType 可对应多条记录）
model MoldCode {
  id         Int    @id @default(autoincrement())
  moldCode   String @unique @map("mold_code") @db.VarChar(30)
  moldType   String @map("mold_type") @db.VarChar(100)
  moldName   String @map("mold_name") @db.VarChar(200)
  moldPrefix String @map("mold_prefix") @db.VarChar(20)
  typeName   String @map("type_name") @db.VarChar(50)
  typeCode   String @map("type_code") @db.VarChar(10)

  @@index([moldType])
  @@map("mold_codes")
  @@schema("mold")
}

/// 模具表（品目主数据）
model Mold {
  id        Int    @id @default(autoincrement())
  moldType  String @map("mold_type") @db.VarChar(100)
  moldName  String @map("mold_name") @db.VarChar(200)
  moldCode  String @map("mold_code") @db.VarChar(30)
  phoneName String @map("phone_name") @db.VarChar(200)
  phoneCode String @map("phone_code") @db.VarChar(20)
  typeCode  String @map("type_code") @db.VarChar(10)
  typeName  String @map("type_name") @db.VarChar(50)
  itemCode  String @unique @map("item_code") @db.VarChar(50)

  @@unique([moldCode, phoneCode])
  @@index([moldCode])
  @@index([phoneCode])
  @@map("molds")
  @@schema("mold")
}

/// 产品编码表
model ProductCode {
  id          Int    @id @default(autoincrement())
  productCode String @map("product_code") @db.VarChar(20)
  productType String @map("product_type") @db.VarChar(100)
  productName String @map("product_name") @db.VarChar(200)
  colorName   String @map("color_name") @db.VarChar(100)
  colorCode   String @map("color_code") @db.VarChar(10)

  @@unique([productCode, colorCode])
  @@index([productType])
  @@map("product_codes")
  @@schema("mold")
}

/// 产品表（品目主数据）
model Product {
  id             Int    @id @default(autoincrement())
  productType    String @map("product_type") @db.VarChar(100)
  productName    String @map("product_name") @db.VarChar(200)
  productCode    String @map("product_code") @db.VarChar(20)
  phoneShortName String @map("phone_short_name") @db.VarChar(200)
  phoneCode      String @map("phone_code") @db.VarChar(20)
  colorName      String @map("color_name") @db.VarChar(100)
  colorCode      String @map("color_code") @db.VarChar(10)
  itemCode       String @unique @map("item_code") @db.VarChar(50)

  @@unique([productCode, phoneCode, colorCode])
  @@index([productCode])
  @@index([phoneCode])
  @@index([colorCode])
  @@map("products")
  @@schema("mold")
}

// ============ OA SCHEMA ============

/// OA审批编号与钉钉实例ID映射缓存表
model OaMapping {
  oaCode          String    @id @map("oa_code") @db.VarChar(100)
  instanceId      String    @map("instance_id") @db.VarChar(100)
  processCode     String?   @map("process_code") @db.VarChar(100)
  formName        String?   @map("form_name") @db.VarChar(255)
  dingCreateTime  DateTime? @map("ding_create_time")
  updateTime      DateTime? @default(now()) @map("update_time") @db.Timestamp()

  @@map("oa_mapping")
  @@schema("oa")
}

/// 钉钉员工表
model DingEmployee {
  dingUserid String  @id @map("ding_userid") @db.VarChar(100)
  empName    String? @map("emp_name") @db.VarChar(200)
  deptId     Int?    @map("dept_id")
  title      String? @db.VarChar(200)
  isBoss     String? @map("is_boss") @db.VarChar(10)

  @@map("ding_employee")
  @@schema("oa")
}

/// 钉钉部门表
model DingDepartment {
  deptId        Int     @id @map("dept_id")
  deptName      String? @map("dept_name") @db.VarChar(200)
  parentDeptId  Int?    @map("parent_dept_id")

  @@map("ding_department")
  @@schema("oa")
}

/// ERP供应商缓存表
model ErpSupplier {
  code       String    @id @db.VarChar(100)
  name       String?   @db.VarChar(255)
  updateTime DateTime? @default(now()) @map("update_time") @db.Timestamp()

  @@map("erp_supplier")
  @@schema("oa")
}

/// ERP物料缓存表
model ErpMaterial {
  code          String    @id @db.VarChar(100)
  name          String?   @db.VarChar(255)
  specification String?   @db.VarChar(500)
  updateTime    DateTime? @default(now()) @map("update_time") @db.Timestamp()

  @@map("erp_material")
  @@schema("oa")
}

/// ERP计量单位缓存表
model ErpUnit {
  code       String    @id @db.VarChar(100)
  name       String?   @db.VarChar(255)
  updateTime DateTime? @default(now()) @map("update_time") @db.Timestamp()

  @@map("erp_unit")
  @@schema("oa")
}

/// ERP税率缓存表
model ErpTax {
  code       String    @id @db.VarChar(100)
  name       String?   @db.VarChar(255)
  rateValue  Decimal?  @map("rate_value") @db.Decimal(10, 4)
  updateTime DateTime? @default(now()) @map("update_time") @db.Timestamp()

  @@map("erp_tax")
  @@schema("oa")
}

/// ERPNext映射配置表
model ErpNextMapping {
  id          Int    @id @default(autoincrement())
  type        String @db.VarChar(30)
  sourceKey   String @map("source_key") @db.VarChar(50)
  targetValue String @map("target_value") @db.VarChar(200)

  @@unique([type, sourceKey])
  @@index([type])
  @@map("erp_next_mappings")
  @@schema("oa")
}

/// ERPNext 同步日志表
model ErpNextSyncLog {
  id             Int       @id @default(autoincrement())
  entityType     String    @map("entity_type") @db.VarChar(20)
  entityCode     String    @map("entity_code") @db.VarChar(100)
  entityName     String?   @map("entity_name") @db.VarChar(200)
  itemGroup      String?   @map("item_group") @db.VarChar(100)
  status         String    @default("PENDING") @db.VarChar(20)
  message        String?   @db.Text
  requestPayload Json?     @map("request_payload")
  responseData   Json?     @map("response_data")
  retryCount     Int       @default(0) @map("retry_count")
  lastTriedAt    DateTime? @map("last_tried_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([entityType])
  @@index([status])
  @@index([entityCode])
  @@map("erp_next_sync_logs")
  @@schema("oa")
}
